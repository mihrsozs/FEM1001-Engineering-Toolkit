    "def fuerza_centrifuga_FEM(masa_carga_kg,velocidad_suspension_ms,\n",
    "                          radio_suspension_m,mostrar=True):\n",
    "    \"\"\"Calcula la fuerza centrífuga horizontal de la carga suspendida durante el giro.\"\"\"\n",
    "\n",
    "    g=9.80665                                              # Aceleración de gravedad [m/s²]\n",
    "\n",
    "    # ------------------------------------------------------------------------------------------------\n",
    "    # CONTROL DE DATOS\n",
    "    # ------------------------------------------------------------------------------------------------\n",
    "    if masa_carga_kg<=0:\n",
    "        raise ValueError('masa_carga_kg debe ser > 0')\n",
    "\n",
    "    if velocidad_suspension_ms<0:\n",
    "        raise ValueError('velocidad_suspension_ms debe ser >= 0')\n",
    "\n",
    "    if radio_suspension_m<=0:\n",
    "        raise ValueError('radio_suspension_m debe ser > 0')\n",
    "\n",
    "    # ------------------------------------------------------------------------------------------------\n",
    "    # VELOCIDAD ANGULAR\n",
    "    # ------------------------------------------------------------------------------------------------\n",
    "    omega_rads=velocidad_suspension_ms/radio_suspension_m       # Velocidad angular omega = v/r [rad/s]\n",
    "    omega_rpm=omega_rads*60/(2*np.pi)                           # Conversión de velocidad angular a rpm\n",
    "\n",
    "    # ------------------------------------------------------------------------------------------------\n",
    "    # ACELERACIÓN CENTRÍPETA\n",
    "    # ------------------------------------------------------------------------------------------------\n",
    "    aceleracion_centripeta_ms2=velocidad_suspension_ms**2/radio_suspension_m  # ac = v²/r = omega²·r [m/s²]\n",
    "\n",
    "    # ------------------------------------------------------------------------------------------------\n",
    "    # FUERZA CENTRÍFUGA EQUIVALENTE SOBRE LA ESTRUCTURA\n",
    "    # ------------------------------------------------------------------------------------------------\n",
    "    F_centrifuga_kgf=masa_carga_kg*aceleracion_centripeta_ms2/g  # Fuerza horizontal radial [kgf]\n",
    "\n",
    "    # ------------------------------------------------------------------------------------------------\n",
    "    # INTERPRETACIÓN MEDIANTE COMPONENTES H-V\n",
    "    # ------------------------------------------------------------------------------------------------\n",
    "    V_kgf=masa_carga_kg                                          # Peso vertical estático de la carga [kgf]\n",
    "    relacion_HV=F_centrifuga_kgf/V_kgf                           # Relación entre fuerza radial y peso vertical [-]\n",
    "    porcentaje_HV=relacion_HV*100                                # Relación H/V expresada en porcentaje [%]\n",
    "    angulo_cable_deg=np.degrees(np.arctan(relacion_HV))          # Inclinación equivalente del cable respecto de vertical [°]\n",
    "    resultante_kgf=np.sqrt(V_kgf**2+F_centrifuga_kgf**2)         # Resultante H-V [kgf]\n",
    "\n",
    "    # ------------------------------------------------------------------------------------------------\n",
    "    # RESULTADOS\n",
    "    # ------------------------------------------------------------------------------------------------\n",
    "    resultados={\n",
    "        'omega_rads':omega_rads,                                 # Velocidad angular [rad/s]\n",
    "        'omega_rpm':omega_rpm,                                   # Velocidad angular [rpm]\n",
    "        'aceleracion_centripeta_ms2':aceleracion_centripeta_ms2, # Aceleración radial [m/s²]\n",
    "        'F_centrifuga_kgf':F_centrifuga_kgf,                     # Fuerza centrífuga equivalente [kgf]\n",
    "        'V_kgf':V_kgf,                                           # Peso vertical estático [kgf]\n",
    "        'H_V':relacion_HV,                                       # Relación horizontal/vertical [-]\n",
    "        'H_V_porcentaje':porcentaje_HV,                          # Relación horizontal/vertical [%]\n",
    "        'angulo_cable_deg':angulo_cable_deg,                     # Inclinación equivalente del cable [°]\n",
    "        'resultante_kgf':resultante_kgf                          # Resultante H-V [kgf]\n",
    "    }\n",
    "\n",
    "    # ------------------------------------------------------------------------------------------------\n",
    "    # PRESENTACIÓN\n",
    "    # ------------------------------------------------------------------------------------------------\n",
    "    if mostrar:\n",
    "        print('--- FEM 1.001 | Fuerza centrífuga de la carga suspendida ---')\n",
    "        print(f'Velocidad punto suspensión = {velocidad_suspension_ms:.4f} m/s')\n",
    "        print(f'Radio punto suspensión     = {radio_suspension_m:.4f} m')\n",
    "        print(f'Velocidad angular omega    = {omega_rads:.6f} rad/s')\n",
    "        print(f'Velocidad angular          = {omega_rpm:.4f} rpm')\n",
    "        print(f'Aceleración centrípeta     = {aceleracion_centripeta_ms2:.4f} m/s²')\n",
    "        print(f'Fuerza centrífuga          = {F_centrifuga_kgf:.4f} kgf')\n",
    "        print(f'Vertical                   = {V_kgf:.4f} kgf')\n",
    "        print(f'H/V                        = {relacion_HV:.4f}')\n",
    "        print(f'H/V                        = {porcentaje_HV:.4f} %')\n",
    "        print(f'Ángulo cable               = {angulo_cable_deg:.4f}°')\n",
    "        print(f'Resultante H-V             = {resultante_kgf:.4f} kgf')\n",
    "\n",
    "    return resultados"
   ]
  },
