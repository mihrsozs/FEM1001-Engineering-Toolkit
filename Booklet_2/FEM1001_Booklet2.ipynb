    "def carga_horizontal_FEM(masa_carga_kg,masa_equivalente_grua_kg,\n",
    "                         velocidad_inicial_ms,velocidad_final_ms,\n",
    "                         tiempo_tramo_s, longitud_cable_m,\n",
    "                         mostrar=True,graficar=True):\n",
    "    \"\"\"Calcula la carga horizontal equivalente según FEM 1.001 Appendix A-2.2.3.\"\"\"\n",
    "\n",
    "    g=9.80665                                           # Aceleración de gravedad [m/s²]\n",
    "\n",
    "    # ------------------------------------------------------------------------------------------------\n",
    "    # DATOS DE ENTRADA\n",
    "    # ------------------------------------------------------------------------------------------------\n",
    "\n",
    "    if masa_carga_kg<=0:raise ValueError('masa_carga_kg debe ser > 0')\n",
    "    if masa_equivalente_grua_kg<=0:raise ValueError('masa_equivalente_grua_kg debe ser > 0')\n",
    "    if velocidad_inicial_ms<0:raise ValueError('velocidad_inicial_ms debe ser >= 0')\n",
    "    if velocidad_final_ms<0:raise ValueError('velocidad_final_ms debe ser >= 0')\n",
    "    if longitud_cable_m<=0:raise ValueError('longitud_cable_m debe ser > 0')\n",
    "    if tiempo_tramo_s<=0:raise ValueError('tiempo_tramo_s debe ser > 0')\n",
    "\n",
    "    # ------------------------------------------------------------------------------------------------\n",
    "    # FUNCIÓN INTERNA PARA CALCULAR psi_h SEGÚN FEM\n",
    "    # ------------------------------------------------------------------------------------------------\n",
    "\n",
    "    def psi_fem(mu,beta):\n",
    "        \"\"\"Determina psi_h para cualquier combinación de mu y beta.\"\"\"\n",
    "        if beta==0: return 0.0                                                  # Sin movimiento horizontal -> psi_h = 0\n",
    "        theta_crit=np.pi if mu<=1 else np.arccos(-1/mu)                         # Theta donde psi_h alcanza su máximo\n",
    "        beta_crit=(theta_crit+mu*np.sin(theta_crit))/(2*np.pi*np.sqrt(1+mu))    # Valor crítico de beta\n",
    "        psi_max=2.0 if mu<=1 else np.sqrt(2+mu+1/mu)                            # Máximo psi_h permitido por la solución FEM\n",
    "        if beta>=beta_crit: return psi_max                                      # Después de beta_crit la curva queda en meseta\n",
    "        termino=2*np.pi*beta*np.sqrt(1+mu)                                      # Segundo miembro de ecuación FEM 2.2.29\n",
    "        ecuacion=lambda theta:theta+mu*np.sin(theta)-termino                    # Ecuación FEM 2.2.29 en forma f(theta)=0\n",
    "        theta=brentq(ecuacion,0,theta_crit)                                     # Obtiene theta mediante solución numérica\n",
    "        psi=np.sqrt((1-np.cos(theta))**2+(1+mu)*np.sin(theta)**2)               # Ecuación FEM para psi_h\n",
    "\n",
    "        return psi\n",
    "\n",
    "    # ------------------------------------------------------------------------------------------------\n",
    "    # PARÁMETROS DINÁMICOS\n",
    "    # ------------------------------------------------------------------------------------------------\n",
    "    delta_velocidad_ms=abs(velocidad_final_ms-velocidad_inicial_ms)         # Cambio de velocidad durante el tramo [m/s]\n",
    "    aceleracion_ms2=delta_velocidad_ms/tiempo_tramo_s                       # Aceleración/desaceleración media Jm = Δv/Tm [m/s²]\n",
    "    Tm_s=tiempo_tramo_s                                                     # Tiempo medio de aceleración/desaceleración [s]\n",
    "    T1_s=2*np.pi*np.sqrt(longitud_cable_m/g)                                # Período natural del péndulo [s]\n",
    "    mu=masa_carga_kg/masa_equivalente_grua_kg                               # Relación de masas mu = m1/m [-]\n",
    "    beta=Tm_s/T1_s                                                          # Relación beta = Tm/T1 [-]\n",
    "    theta_crit=np.pi if mu<=1 else np.arccos(-1/mu)                         # Theta crítico correspondiente al caso evaluado\n",
    "    beta_crit=(theta_crit+mu*np.sin(theta_crit))/(2*np.pi*np.sqrt(1+mu))    # Beta crítico para el caso evaluado\n",
    "    psi_h=psi_fem(mu,beta)                                                  # Coeficiente dinámico horizontal FEM [-]\n",
    "\n",
    "    # ------------------------------------------------------------------------------------------------\n",
    "    # FUERZAS EQUIVALENTES\n",
    "    # ------------------------------------------------------------------------------------------------\n",
    "\n",
    "    Fcm_kgf=masa_carga_kg*aceleracion_ms2/g                # Fuerza horizontal media m·a [kgf]\n",
    "    Fcmax_kgf=psi_h*Fcm_kgf                                # Fuerza horizontal máxima equivalente [kgf]\n",
    "    V_kgf=masa_carga_kg                                    # Peso vertical estático de la carga suspendida [kgf]\n",
    "    relacion_HV=Fcmax_kgf/V_kgf                            # Relación entre componente horizontal y vertical [-]\n",
    "    porcentaje_HV=relacion_HV*100                          # Fuerza horizontal como porcentaje de la vertical [%]\n",
    "    angulo_cable_deg=np.degrees(np.arctan(relacion_HV))    # Inclinación equivalente del cable respecto de vertical [°]\n",
    "    resultante_kgf=np.sqrt(V_kgf**2+Fcmax_kgf**2)          # Resultante equivalente H-V [kgf]\n",
    "\n",
    "    # ------------------------------------------------------------------------------------------------\n",
    "    # RESULTADOS\n",
    "    # ------------------------------------------------------------------------------------------------\n",
    "\n",
    "    resultados={\n",
    "        'velocidad_inicial_ms':velocidad_inicial_ms,\n",
    "        'velocidad_final_ms':velocidad_final_ms,\n",
    "        'delta_velocidad_ms':delta_velocidad_ms,\n",
    "        'aceleracion_ms2':aceleracion_ms2,\n",
    "        'Tm_s':Tm_s,\n",
    "        'T1_s':T1_s,\n",
    "        'mu':mu,\n",
    "        'beta':beta,\n",
    "        'beta_crit':beta_crit,\n",
    "        'psi_h':psi_h,\n",
    "        'Fcm_kgf':Fcm_kgf,\n",
    "        'Fcmax_kgf':Fcmax_kgf,\n",
    "        'V_kgf':V_kgf,\n",
    "        'H_V':relacion_HV,\n",
    "        'H_V_porcentaje':porcentaje_HV,\n",
    "        'angulo_cable_deg':angulo_cable_deg,\n",
    "        'resultante_kgf':resultante_kgf\n",
    "    }\n",
    "\n",
    "    # ------------------------------------------------------------------------------------------------\n",
    "    # IMPRESIÓN DE RESULTADOS\n",
    "    # ------------------------------------------------------------------------------------------------\n",
    "\n",
    "    if mostrar:\n",
    "        print('--- FEM 1.001 | Appendix A-2.2.3 ---')\n",
    "        # print(f'Velocidad inicial    = {velocidad_inicial_ms:.4f} m/s')\n",
    "        # print(f'Velocidad final      = {velocidad_final_ms:.4f} m/s')\n",
    "        # print(f'Cambio velocidad Δv  = {delta_velocidad_ms:.4f} m/s')\n",
    "        print(f'Aceleración media Jm = {aceleracion_ms2:.4f} m/s²')\n",
    "        print(f'Tm                    = {Tm_s:.4f} s')\n",
    "        print(f'T1                    = {T1_s:.4f} s')\n",
    "        print(f'mu                    = {mu:.4f}')\n",
    "        print(f'beta                  = {beta:.4f}')\n",
    "        print(f'beta crítico          = {beta_crit:.4f}')\n",
    "        print(f'psi_h                 = {psi_h:.4f}')\n",
    "        print(f'Fcm                   = {Fcm_kgf:.4f} kgf')\n",
    "        print(f'Fc,max                = {Fcmax_kgf:.4f} kgf')\n",
    "        print(f'Vertical              = {V_kgf:.4f} kgf')\n",
    "        print(f'H/V                   = {relacion_HV:.4f}')\n",
    "        print(f'H/V                   = {porcentaje_HV:.4f} %')\n",
    "        print(f'Ángulo cable          = {angulo_cable_deg:.4f}°')\n",
    "        print(f'Resultante H-V        = {resultante_kgf:.4f} kgf')\n",
    "\n",
    "    # ------------------------------------------------------------------------------------------------\n",
    "    # GRÁFICO FEM\n",
    "    # ------------------------------------------------------------------------------------------------\n",
    "\n",
    "    if graficar:\n",
    "\n",
    "        beta_max=max(0.50,beta*1.10)                      # Amplía automáticamente el gráfico si el caso supera beta=0.5\n",
    "        beta_graf=np.linspace(0,beta_max,500)             # Valores de beta utilizados para generar las curvas\n",
    "\n",
    "        mu_FEM=[0,0.1,0.5,1,2,3,4,5]                     # Curvas de referencia de la Figura FEM\n",
    "\n",
    "        plt.figure(figsize=(6,4),dpi=100)\n",
    "\n",
    "        plt.grid(which=\"major\",alpha=0.15)\n",
    "        plt.minorticks_on()\n",
    "        plt.grid(which=\"minor\",alpha=0.05)\n",
    "\n",
    "        for mu_i in mu_FEM:\n",
    "            psi_graf=[psi_fem(mu_i,b) for b in beta_graf]\n",
    "            plt.plot(beta_graf,psi_graf,label=fr'$\\mu={mu_i}$')\n",
    "\n",
    "        psi_actual=[psi_fem(mu,b) for b in beta_graf]\n",
    "\n",
    "        plt.plot(beta_graf,psi_actual,'--',linewidth=2.5,\n",
    "                 label=fr'Caso analizado: $\\mu={mu:.4f}$')\n",
    "\n",
    "        plt.scatter(beta,psi_h,s=90,zorder=5,\n",
    "                    label=fr'$(\\beta,\\psi_h)=({beta:.4f},{psi_h:.4f})$')\n",
    "\n",
    "        plt.axvline(beta,linestyle=':',alpha=0.6)\n",
    "        plt.axhline(psi_h,linestyle=':',alpha=0.6)\n",
    "\n",
    "        plt.xlabel(r'$\\beta=T_m/T_1$',fontsize=12)\n",
    "        plt.ylabel(r'$\\psi_h$',fontsize=12)\n",
    "\n",
    "        plt.title('FEM 1.001 - Appendix A-2.2.3\\nCoeficiente dinámico horizontal de la carga suspendida',\n",
    "                  fontsize=14,fontweight='bold')\n",
    "\n",
    "        plt.xlim(0,beta_max)\n",
    "        plt.ylim(0,max(3.0,psi_h*1.15))\n",
    "        plt.legend(loc=4,fontsize=8,ncol=2,frameon=False)\n",
    "        plt.tight_layout()\n",
    "        plt.show()\n",
    "\n",
    "    return resultados"
   ]
